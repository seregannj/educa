# База данных.
# Пусто → локальный PGlite в .data/pglite (только для разработки).
# В продакшене (Vercel) укажи строку подключения Postgres:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Публичный адрес сайта — база для OG-разметки, canonical и sitemap.
# В продакшене укажи реальный домен, иначе метаданные соберутся вокруг
# адреса деплоя Vercel.
# NEXT_PUBLIC_SITE_URL=https://твой-домен.ru

# Хосты, которым разрешён dev-сервер Next.js (локальный предпросмотр).
# ALLOWED_DEV_ORIGINS=localhost:3000
